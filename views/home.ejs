<%- include('partials/header') %>
<main id="main" class="home">
  <section class="hero">
    <p class="eyebrow inline-flex items-center gap-3"><span class="h-px w-8 bg-astra-gold/60" aria-hidden="true"></span><%= tr('ดวงของคุณ ใต้แสงดาว', 'Your stars, gently read') %></p>
    <h1>Astra</h1>
    <p class="lead">
      <%= tr('เลือกหมวดที่อยากรู้ ใส่วันเกิด แล้วรับคำทำนายที่เก็บไว้ในประวัติของคุณโดยอัตโนมัติ',
             'Pick a category, enter your birth date and get a reading that is saved to your history.') %>
    </p>
    <div class="cta">
      <% if (!user) { %>
        <% if (locals.googleEnabled) { %>
          <a class="btn btn-primary" href="/auth/google"><%= tr('เข้าสู่ระบบด้วย Google', 'Sign in with Google') %></a>
        <% } else { %>
          <p class="notice"><%= tr('ยังไม่ได้ตั้งค่า Google login ในไฟล์ .env', 'Google login is not configured in .env yet.') %></p>
        <% } %>
      <% } %>
      <% if (user) { %>
        <p class="greeting"><%= tr('สวัสดี', 'Hello') %>, <strong><%= user.displayName %></strong></p>
        <a class="btn btn-primary" href="/predict"><%= tr('เริ่มดูดวง', 'Start a reading') %></a>
      <% } %>
    </div>
  </section>

  <% if (locals.stats) { %>
    <section class="stats card backdrop-blur-sm" aria-label="<%= tr('สถิติของคุณ', 'Your statistics') %>">
      <h2><%= tr('สถิติของคุณ', 'Your statistics') %></h2>
      <p><%= tr('จำนวนครั้งที่ดูดวง', 'Total readings') %>: <strong><%= stats.total %></strong></p>
      <p>
        <%= tr('ดูดวงครั้งแรกเมื่อ', 'First reading on') %>:
        <strong><%= stats.firstDate ? stats.firstDate.toLocaleDateString(lang === 'th' ? 'th-TH' : 'en-GB') : '-' %></strong>
      </p>
    </section>
  <% } %>
</main>
<%- include('partials/footer') %>
