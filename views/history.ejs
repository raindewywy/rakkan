<%- include('partials/header') %>
<main id="main" class="page history">
  <h1><%= tr('ประวัติการดูดวง', 'Reading history') %></h1>

  <div class="toolbar">
    <%# ----- search (ticket 16) ----- %>
    <form class="search" method="get" action="/history" role="search">
      <label class="visually-hidden" for="q"><%= tr('ค้นหาในประวัติ', 'Search history') %></label>
      <input id="q" name="q" type="search" value="<%= q %>" placeholder="<%= tr('ค้นหาคำทำนาย…', 'Search readings…') %>">
      <% if (category) { %><input type="hidden" name="category" value="<%= category %>"><% } %>
      <button class="btn" type="submit"><%= tr('ค้นหา', 'Search') %></button>
    </form>

    <%# ----- filter by category (ticket 19) ----- %>
    <form class="filter" method="get" action="/history">
      <label class="visually-hidden" for="category"><%= tr('กรองตามหมวด', 'Filter by category') %></label>
      <select id="category" name="category">
        <option value=""><%= tr('ทุกหมวด', 'All categories') %></option>
        <% categories.forEach(function (key) { %>
          <option value="<%= key %>" <%= category === key ? 'selected' : '' %>><%= categoryInfo[key][lang] %></option>
        <% }); %>
      </select>
      <% if (q) { %><input type="hidden" name="q" value="<%= q %>"><% } %>
      <button class="btn" type="submit"><%= tr('กรอง', 'Filter') %></button>
    </form>
  </div>

  <% if (items.length === 0) { %>
    <% if (q) { %>
      <p class="empty card"><%= tr('ไม่พบประวัติที่ตรงกับ “' + q + '”', 'No readings found for “' + q + '”.') %></p>
      <a class="btn" href="/history<%= category ? '?category=' + encodeURIComponent(category) : '' %>"><%= tr('ล้างคำค้นหา', 'Clear search') %></a>
    <% } else { %>
    <p class="empty card"><%= tr('ยังไม่มีประวัติการดูดวง ลองดูดวงครั้งแรกของคุณเลย', 'No readings yet. Make your first reading!') %></p>
    <a class="btn btn-primary" href="/predict"><%= tr('เริ่มดูดวง', 'Start a reading') %></a>
    <% } %>
  <% } else { %>
  <div class="table-wrap" role="region" aria-label="<%= tr('ตารางประวัติการดูดวง', 'Reading history table') %>" tabindex="0">
    <table class="history-table">
      <thead>
        <tr>
          <th scope="col"><%= tr('วันที่', 'Date') %></th>
          <th scope="col"><%= tr('หมวด', 'Category') %></th>
          <th scope="col"><%= tr('คำทำนาย', 'Reading') %></th>
          <th scope="col"><%= tr('ระดับ', 'Level') %></th>
          <th scope="col"><%= tr('ดู', 'View') %></th>
          <%# ----- delete (ticket 20) ----- %>
          <th scope="col"><%= tr('ลบ', 'Delete') %></th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(function (item) { %>
          <tr data-category="<%= item.category %>">
            <td><%= new Date(item.createdAt).toLocaleString(lang === 'th' ? 'th-TH' : 'en-GB') %></td>
            <td><span aria-hidden="true"><%= categoryInfo[item.category].icon %></span> <%= categoryInfo[item.category][lang] %></td>
            <td><%= item.result.headline %></td>
            <td><span class="badge badge-<%= item.result.level %>"><%= item.result.level %></span></td>
            <td><a href="/result/<%= item.id %>"><%= tr('เปิด', 'Open') %></a></td>
            <td>
              <form method="post" action="/history/<%= item.id %>/delete">
                <button class="btn btn-danger btn-small" type="submit" aria-label="<%= tr('ลบคำทำนายนี้', 'Delete this reading') %>"><%= tr('ลบ', 'Delete') %></button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</main>
<%- include('partials/footer') %>
