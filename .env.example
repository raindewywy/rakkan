# Copy this file to .env and fill in the values. Never commit .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
SESSION_SECRET=
# Optional: horoscope API URL template, {sign} is replaced by the zodiac sign.
# Leave empty to use only the local Astra readings.
HOROSCOPE_API_URL=
PORT=3000
# Set to true only when the site is served over HTTPS (production).
COOKIE_SECURE=
